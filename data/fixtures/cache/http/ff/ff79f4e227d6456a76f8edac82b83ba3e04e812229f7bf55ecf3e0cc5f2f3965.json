edWords": ["python", ".", "org", "dev", "peps", "pep", "0020"], "value": "https://www.<em>python.org</em>/<em>dev</em>/<em>peps</em>/<em>pep-0020</em>/"}}, "_tags": ["story", "author_mattchamb", "story_17421679"], "author": "mattchamb", "created_at": "2018-06-29T00:57:37Z", "created_at_i": 1530233857, "num_comments": 0, "objectID": "17421679", "points": 2, "story_id": 17421679, "title": "The Zen of Python (2004)", "updated_at": "2024-09-20T02:39:54Z", "url": "https://www.python.org/dev/peps/pep-0020/"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "qin"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "The Zen of Python"}, "url": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["python", ".", "org", "dev", "peps", "pep", "0020"], "value": "https://www.<em>python.org</em>/<em>dev</em>/<em>peps</em>/<em>pep-0020</em>/"}}, "_tags": ["story", "author_qin", "story_21845684"], "author": "qin", "created_at": "2019-12-20T17:16:11Z", "created_at_i": 1576862171, "num_comments": 0, "objectID": "21845684", "points": 1, "story_id": 21845684, "title": "The Zen of Python", "updated_at": "2024-09-20T05:20:36Z", "url": "https://www.python.org/dev/peps/pep-0020/"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "hemansan"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "Zen of python"}, "url": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["python", ".", "org", "dev", "peps", "pep", "0020"], "value": "https://www.<em>python.org</em>/<em>dev</em>/<em>peps</em>/<em>pep-0020</em>/"}}, "_tags": ["story", "author_hemansan", "story_17713614"], "author": "hemansan", "created_at": "2018-08-08T06:28:42Z", "created_at_i": 1533709722, "num_comments": 0, "objectID": "17713614", "points": 1, "story_id": 17713614, "title": "Zen of python", "updated_at": "2024-09-20T02:50:00Z", "url": "https://www.python.org/dev/peps/pep-0020/"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "throaway54321"}, "story_text": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["python", ".", "org", "dev", "peps", "pep", "0020"], "value": "I have 5 years of experience writing ML software and working with distributed systems for large-scale data processing (10s-100s of TBs).<p>I have some hard-won experience, but I am by no means done learning. I try to be open-minded, and I've accepted that there's no way I'll ever truly be an expert in every aspect of SW engineering.<p>Four months ago, I joined a new team at a new company (my previous tech was purchased, and I wanted to move on to other projects). Writing code with this team has been a really difficult experience. Every change that I make I get pep8'd and abused on style. With each PR that I make, a long thread (&gt;50 back-n-forths) ensues with comments like &quot;let's put the calls in this file instead of that file&quot;, &quot;let's actually put the code here in this file&quot;, &quot;your code should be under 80 characters long&quot;, etc. What's annoying is that this codebase is a mess, and these comments appear to me as hazing as they are not uniformly applied to others: lots of inconsistent styles; really complicated class hierarchies; major violations of YAGNI; major violations of pep8. The codebase size is &lt;3K LOC, and I've worked on codebases with 100Ks of lines; so it's really frustrating to deal with the nitpicking on something that seemingly wastes everybody's time, and doesn't provide opportunities for growth or learning.<p>So being a good new employee, I've asked for a style guide and was handed this link: https://www.<em>python.org</em>/<em>dev</em>/<em>peps</em>/<em>pep-000</em>8/. I've been programming in python for 10 years, and I just found this to be insulting. I've worked on projects that are orders of magnitude more complex than the current one; and yet none of my experience matters, and I feel that I'm being viewed as a junior since I've been given smaller and smaller &quot;projects&quot; (if they could be called that) to work on.<p>I believe that my teammates see me as a bad apple. I want to do something constructive here, but I'm feeling pretty bruised and confused.<p>Thanks for any advice."}, "title": {"fullyHighlighted": false, "matchLevel": "partial", "matchedWords": ["dev"], "value": "Ask HN: What to do if I'm a bad fit for <em>dev</em> team?"}}, "_tags": ["story", "author_throaway54321", "story_15504316", "ask_hn"], "author": "throaway54321", "children": [15504544, 15504560, 15504682, 15504817, 15504941, 15505110, 15505534, 15506746, 15507007, 15507127, 15516199, 15519143, 15521128], "created_at": "2017-10-18T23:50:43Z", "created_at_i": 1508370643, "num_comments": 21, "objectID": "15504316", "points": 11, "story_id": 15504316, "story_text": "I have 5 years of experience writing ML software and working with distributed systems for large-scale data processing (10s-100s of TBs).<p>I have some hard-won experience, but I am by no means done learning. I try to be open-minded, and I&#x27;ve accepted that there&#x27;s no way I&#x27;ll ever truly be an expert in every aspect of SW engineering.<p>Four months ago, I joined a new team at a new company (my previous tech was purchased, and I wanted to move on to other projects). Writing code with this team has been a really difficult experience. Every change that I make I get pep8&#x27;d and abused on style. With each PR that I make, a long thread (&gt;50 back-n-forths) ensues with comments like &quot;let&#x27;s put the calls in this file instead of that file&quot;, &quot;let&#x27;s actually put the code here in this file&quot;, &quot;your code should be under 80 characters long&quot;, etc. What&#x27;s annoying is that this codebase is a mess, and these comments appear to me as hazing as they are not uniformly applied to others: lots of inconsistent styles; really complicated class hierarchies; major violations of YAGNI; major violations of pep8. The codebase size is &lt;3K LOC, and I&#x27;ve worked on codebases with 100Ks of lines; so it&#x27;s really frustrating to deal with the nitpicking on something that seemingly wastes everybody&#x27;s time, and doesn&#x27;t provide opportunities for growth or learning.<p>So being a good new employee, I&#x27;ve asked for a style guide and was handed this link: https:&#x2F;&#x2F;www.python.org&#x2F;dev&#x2F;peps&#x2F;pep-0008&#x2F;. I&#x27;ve been programming in python for 10 years, and I just found this to be insulting. I&#x27;ve worked on projects that are orders of magnitude more complex than the current one; and yet none of my experience matters, and I feel that I&#x27;m being viewed as a junior since I&#x27;ve been given smaller and smaller &quot;projects&quot; (if they could be called that) to work on.<p>I believe that my teammates see me as a bad apple. I want to do something constructive here, but I&#x27;m feeling pretty bruised and confused.<p>Thanks for any advice.", "title": "Ask HN: What to do if I'm a bad fit for dev team?", "updated_at": "2024-09-20T01:26:16Z"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "_grrr"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "Style Guide for Python Code"}, "url": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["python", ".", "org", "dev", "peps", "pep", "0020"], "value": "http://www.<em>python.org</em>/<em>dev</em>/<em>peps</em>/<em>pep-000</em>8/"}}, "_tags": ["story", "author__grrr", "story_3222045"], "author": "_grrr", "children": [3222124], "created_at": "2011-11-10T21:51:00Z", "created_at_i": 1320961860, "num_comments": 0, "objectID": "3222045", "points": 15, "story_id": 3222045, "title": "Style Guide for Python Code", "updated_at": "2024-09-19T18:03:29Z", "url": "http://www.python.org/dev/peps/pep-0008/"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "giis"}, "story_text": {"matchLe