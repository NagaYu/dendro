", "abs", "1706", ".", "03762"], "value": "https://<em>arxiv.org</em>/<em>abs</em>/<em>1706.03762</em>"}}, "_tags": ["story", "author_Bluestein", "story_44415329"], "author": "Bluestein", "children": [44415357], "created_at": "2025-06-29T18:43:24Z", "created_at_i": 1751222604, "num_comments": 2, "objectID": "44415329", "points": 6, "story_id": 44415329, "title": "Attention Is All You Need", "updated_at": "2025-07-10T06:03:36Z", "url": "https://arxiv.org/abs/1706.03762"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "shcheklein"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "Attention Is All You Need"}, "url": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["arxiv", ".", "org", "abs", "1706", ".", "03762"], "value": "https://<em>arxiv.org</em>/<em>abs</em>/<em>1706.03762</em>"}}, "_tags": ["story", "author_shcheklein", "story_33677144"], "author": "shcheklein", "created_at": "2022-11-20T01:35:15Z", "created_at_i": 1668908115, "num_comments": 0, "objectID": "33677144", "points": 4, "story_id": 33677144, "title": "Attention Is All You Need", "updated_at": "2024-09-20T12:41:50Z", "url": "https://arxiv.org/abs/1706.03762"}, {"_highlightResult": {"author": {"matchLevel": "none", "matchedWords": [], "value": "simonebrunozzi"}, "title": {"matchLevel": "none", "matchedWords": [], "value": "Attention is all you need (2017)"}, "url": {"fullyHighlighted": false, "matchLevel": "full", "matchedWords": ["arxiv", ".", "org", "abs", "1706", ".", "03762"], "value": "https://<em>arxiv.org</em>/<em>abs</em>/<em>1706.03762</em>"}}, "_tags": ["story", "author_simonebrunozzi", "story_43729466"], "author": "simonebrunozzi", "created_at": "2025-04-18T16:17:30Z", "created_at_i": 1744993050, "num_comments": 0, "objectID": "43729466", "points": 3, "story_id": 43729466, "title": "Attention is all you need (2017)", "updated_at": "2025-04-19T21:06:34Z", "url": "https://arxiv.org/abs/1706.03762"}, {"_highlightResult": {"aut