# NOTE: these are deliverables and are tracked on purpose --
#   data/fixtures/cache/  real archive responses, so tests and benchmarks replay offline
#   data/corpus/          the real documents the evaluation corpus is built from
#   results/*.csv         measured numbers behind every claim in the README
#   figures/*.png         rendered from those CSVs

# Verbatim third-party page content, fetched by scripts/fetch_corpus.py.
# NOT redistributed: these are full copies of pages owned by the FSF, the Linux
# Foundation, the PSF, the curl project and others, under a mix of licences.
# Dendro only ever needs their fingerprints, and the benchmark runs without them
# (the archive layer is 450 arXiv documents instead of 458). Re-fetch locally
# with `python -m scripts.fetch_corpus --skip-arxiv`.
data/local/

# Space staging is assembled on demand by scripts/publish_space.py
/space/dendro/
/space/figures/
/space/data/
